{
  "id": "science-news",
  "name": "Science News",
  "display_names": {
    "zh": "科学新闻"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 4000,
    "enrichment_max_chars": 8000,
    "sampling": "prefix"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      {
        "id": "summary",
        "type": "section",
        "tools": [],
        "primary": true
      },
      {
        "id": "background",
        "type": "section",
        "tools": ["web_search"]
      },
      {
        "id": "significance",
        "type": "section",
        "tools": ["web_search"],
        "optional": true
      }
    ]
  }
}
